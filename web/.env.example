# Copie este arquivo para ".env.local" e preencha. O ".env.local" NUNCA vai para o Git.

# --- Supabase (projeto "Ienvia", São Paulo) ---------------------------------
# Endereço do projeto e a chave PÚBLICA (publishable/anon). Podem aparecer no navegador:
# quem protege os dados é o RLS do banco, não o segredo desta chave.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# Domínio interno das contas que entram só com nome de usuário (padrão: zapia.local,
# o mesmo do sistema antigo, para as contas migradas continuarem funcionando).
# AUTH_DOMINIO_USUARIO=zapia.local

# --- Só em desenvolvimento (ignoradas em produção) ---------------------------
# Use as duas juntas quando o painel roda numa prévia, atrás de um proxy em outro
# domínio e dentro de um quadro (iframe):
#   1) origens extras aceitas pelo servidor de desenvolvimento;
#   2) cookies no formato que o navegador aceita dentro de um quadro.
# IENVIA_ORIGENS_DEV=*.e2b.app
# IENVIA_PREVIA_EMBUTIDA=1
